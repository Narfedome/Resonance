	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\ChannelVolumeSlider\ChannelVolumeSliderView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\AudioMixer\AudioMixerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellSelectorPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackSelectorPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\CreateEdit\LibrarySpellEditPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\CreateEdit\LibraryTrackEditPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Resources\Styles\Icons.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Strings\AppStrings.resx" />
	  <EmbeddedResource Update="Strings\AppStrings.en.resx">
	    <Culture>en</Culture>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Components\TrackButton\TrackButtonView.xaml.cs">
	    <DependentUpon>TrackButtonView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Components\LibraryItemImage\LibraryItemImageView.xaml.cs">
	    <DependentUpon>LibraryItemImageView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\AudioMixer\AudioMixerPage.xaml.cs">
	    <DependentUpon>AudioMixerPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Spell\LibrarySpellSelectorPage.xaml.cs">
	    <DependentUpon>LibrarySpellSelectorPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Track\LibraryTrackSelectorPage.xaml.cs">
	    <DependentUpon>LibraryTrackSelectorPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Spell\LibrarySpellView.xaml.cs">
