	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\OpenSans-Semibold.ttf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\PirataOne-Regular.ttf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	  <MauiFont Update="Resources\Fonts\rpgawesome-webfont.ttf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </MauiFont>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\AppIcon\appicon.svg">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Update="Resources\Images\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Resonance.Core\Resonance.Core.csproj" />
	</ItemGroup>


	<!-- Auto-incrémente le patch en comptant les commits git et fixe ApplicationDisplayVersion.
	     L'app lit sa version au runtime via AppInfo.Current.VersionString, qui reflète exactement
	     ce qui a été packagé (AndroidManifest/Info.plist/Package.appxmanifest) : plus de fichier
	     généré séparément à garder en synchro.
	     _GetAndroidPackageName est la cible qui fige _AndroidVersionName = $(ApplicationDisplayVersion)
	     pour le manifeste Android ; elle tourne très tôt (via AndroidPrepareForBuild, avant CoreCompile),
	     donc on doit y accrocher ce calcul explicitement sous peine de packager la version statique.
	     Idem côté Windows : MauiGeneratePackageAppxManifest (package Resizetizer) lit
	     ApplicationDisplayVersion pour générer Package.appxmanifest, puis GetAssemblyAttributes en
	     extrait la version pour l'embarquer en AssemblyMetadataAttribute (ce que AppInfo.VersionString
	     lit vraiment au runtime, l'appli étant non empaquetée) - les deux doivent tourner APRÈS ce
	     calcul, sous peine de packager/embarquer la version statique par défaut du csproj. -->
	<Target Name="SetVersionFromGit" BeforeTargets="CoreCompile;_GenerateJavaStubs;GetAssemblyVersion;_GetAndroidPackageName;MauiGeneratePackageAppxManifest;GetAssemblyAttributes">
		<Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
		</Exec>
		<PropertyGroup Condition="'$(_GitCommitCount)' != ''">
			<_AppPatch>$(_GitCommitCount.Trim())</_AppPatch>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_AppPatch)' == ''">
			<_AppPatch>0</_AppPatch>
		</PropertyGroup>
		<!-- ApplicationVersion (versionCode Android) suit le meme compteur : le Play Store refuse tout
		     upload dont le versionCode n'est pas strictement superieur au precedent. Plancher a 1, un
		     versionCode a 0 etant invalide. -->
		<PropertyGroup>
			<ApplicationDisplayVersion>$(AppVersionMajor).$(AppVersionMinor).$(_AppPatch)</ApplicationDisplayVersion>
			<ApplicationVersion>$(_AppPatch)</ApplicationVersion>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_AppPatch)' == '0'">
			<ApplicationVersion>1</ApplicationVersion>
		</PropertyGroup>
		<Message Text="Version: $(ApplicationDisplayVersion) (versionCode $(ApplicationVersion))" Importance="high" />

		<!-- Le manifeste Android est régénéré par une cible incrémentale (_GenerateJavaStubs) qui ne
		     surveille pas cette propriété : sans supprimer son stamp, la version packagée peut rester
		     figée sur une valeur périmée même quand ApplicationDisplayVersion change. -->
		<ItemGroup Condition="Exists('$(_AndroidStampDirectory)_GenerateJavaStubs.stamp')">
			<_StampToDelete Include="$(_AndroidStampDirectory)_GenerateJavaStubs.stamp" />
		</ItemGroup>

		<!-- Idem côté Windows : le stamp de MauiGeneratePackageAppxManifest ne surveille en incrémental
		     que le Package.appxmanifest source, jamais cette propriété. -->
		<ItemGroup Condition="Exists('$(IntermediateOutputPath)mauimanifest.stamp')">
			<_StampToDelete Include="$(IntermediateOutputPath)mauimanifest.stamp" />
		</ItemGroup>

		<Delete Files="@(_StampToDelete)" Condition="'@(_StampToDelete)' != ''" />
	</Target>

</Project>
