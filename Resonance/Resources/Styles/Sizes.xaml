<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Taille minimale (Height/Width) des contrôles interactifs, cf. usages dans Styles.xaml : 44
         est la cible tactile recommandée (Android, au doigt) mais surdimensionnée à la souris sur
         Desktop, où les apps tournent plutôt autour de 32. -->
    <OnIdiom x:Key="AppMinTouchTarget" x:TypeArguments="x:Double" Phone="44" Tablet="44" Desktop="32" />

    <!-- Taille de police de base et titres, cf. usages dans Styles.xaml : MAUI ne mappe pas les
         tailles de police 1:1 entre plateformes - la même valeur rend visuellement plus grande sur
         Windows/WinUI qu'sur Android à densité équivalente, d'où une base plus petite sur Desktop. -->
    <OnIdiom x:Key="AppFontSizeBase" x:TypeArguments="x:Double" Phone="14" Tablet="14" Desktop="12" />
    <!-- Titres de carte de section (Settings, ImportExport...) et autres labels "un cran au-dessus
         du texte courant" : la taille la plus repetee de l'appli sans avoir de token dedie avant
         celui-ci (22 occurrences en dur). -->
    <OnIdiom x:Key="AppFontSizeSectionTitle" x:TypeArguments="x:Double" Phone="16" Tablet="16" Desktop="14" />

    <!-- Padding des boutons et de la carte des dialogues thémés, cf. usages dans Styles.xaml : plus
         compact sur Desktop, cohérent avec AppMinTouchTarget/AppFontSizeBase ci-dessus. -->
    <OnIdiom x:Key="AppButtonPadding" x:TypeArguments="Thickness" Phone="14,10" Tablet="14,10" Desktop="12,7" />
    <OnIdiom x:Key="AppDialogCardPadding" x:TypeArguments="x:Double" Phone="20" Tablet="20" Desktop="16" />

    <!-- Boutons "valeur + action" compacts (sélecteur de langue/thème, nettoyage stockage... dans
         Settings) : le MinimumHeightRequest hérité du Style Button implicite (AppMinTouchTarget)
         force ces lignes à une hauteur de cible tactile même quand leur contenu (texte court) est
         bien plus petit - la carte autour parait alors plus paddée qu'elle ne l'est vraiment. Cible
         tactile plus modeste ici, ce ne sont pas des actions primaires. -->
    <OnIdiom x:Key="AppInlineButtonMinSize" x:TypeArguments="x:Double" Phone="36" Tablet="36" Desktop="20" />

    <!-- Padding intérieur des Border "carte de section" (Settings, ImportExport, Onboarding) : même
         principe que AppDialogCardPadding, valeur de base différente (ces cartes sont plus denses,
         souvent plusieurs par page). -->
    <OnIdiom x:Key="AppSectionCardPadding" x:TypeArguments="x:Double" Phone="16" Tablet="16" Desktop="12" />

    <!-- Lignes de l'accordéon Campagnes (RowBorderStyle dans CampaignPage.xaml) : plus compact sur
         Desktop, comme les cartes de section ci-dessus. -->
    <OnIdiom x:Key="AppAccordionRowPadding" x:TypeArguments="Thickness" Phone="8,6" Tablet="8,6" Desktop="8,6" />
    <OnIdiom x:Key="AppAccordionRowMinHeight" x:TypeArguments="x:Double" Phone="52" Tablet="52" Desktop="40" />

    <!-- Espacement entre lignes de l'accordéon Campagnes (toutes aplaties dans un seul CollectionView
         via RowTemplateSelector - l'espacement entre deux lignes vient donc uniquement de la Margin/
         Padding de chacune, pas d'un ItemSpacing du CollectionView).
         Marge de la ligne Campagne : haut plus généreux que bas, pour que campagne-à-campagne reste
         visuellement un vrai groupe séparé (surtout utile sur Desktop, une fois chapitre/scène
         resserrés ci-dessous) sans pour autant élargir l'écart campagne-vers-son-premier-chapitre. -->
    <OnIdiom x:Key="AppCampaignRowMargin" x:TypeArguments="Thickness" Phone="0,4" Tablet="0,4" Desktop="0,8,0,0" />
    <!-- Padding de la ligne Chapitre (haut/bas seulement - gauche/droite gèrent l'indentation/colonne
         chevron, inchangés) : desserré à l'origine (10/11), resserré ici pour un accordéon plus dense. -->
    <OnIdiom x:Key="AppChapterRowPadding" x:TypeArguments="Thickness" Phone="0,5,8,6" Tablet="0,5,8,6" Desktop="0,3,8,3" />
    <!-- Padding de la ligne Scène : reduction discrète sur Phone/Tablet ("très peu" demandé), nette
         sur Desktop (cohérent avec le reste de l'accordéon resserré). -->
    <OnIdiom x:Key="AppSceneRowPadding" x:TypeArguments="Thickness" Phone="0,7" Tablet="0,7" Desktop="0,3" />

    <!-- AudioMixer (ChannelStripView / ChannelVolumeSliderView) : plus de place à la souris sur
         Desktop, plus de pistes visibles confortablement sur un petit écran Phone. -->
    <OnIdiom x:Key="AppChannelStripWidth" x:TypeArguments="x:Double" Phone="50" Tablet="50" Desktop="34" />
    <OnIdiom x:Key="AppChannelSliderMinHeight" x:TypeArguments="x:Double" Phone="100" Tablet="100" Desktop="140" />

</ResourceDictionary>
