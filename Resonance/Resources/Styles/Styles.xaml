    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource AppBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource AppText}" />
        <Setter Property="IconColor" Value="{DynamicResource AppText}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource AppSurface}" />
        <Setter Property="BarTextColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource AppAccent}" />
    </Style>

</ResourceDictionary>
