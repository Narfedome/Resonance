    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource AppText}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBase}"/>
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppMinTouchTarget}"/>
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppMinTouchTarget}"/>
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource AppBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource AppBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource AppText}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource AppText}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource AppTextMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource AppSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource AppAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource AppTextMuted}" />
