  </data>
  <data name="OnboardingStructureBody" xml:space="preserve">
    <value>Organize each campaign into chapters, and each chapter into scenes. A scene keeps its own tracks and their volumes.</value>
  </data>
  <data name="OnboardingPlayTitle" xml:space="preserve">
    <value>Your sounds, ready to play</value>
  </data>
  <data name="OnboardingPlayBody" xml:space="preserve">
    <value>Import your music and ambiences into the Library. Tap “Launch” on a scene to open its tracks in the mixer.</value>
  </data>
