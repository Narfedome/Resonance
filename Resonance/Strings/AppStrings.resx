  </data>
  <data name="TourMixerChannelTrackTitle" xml:space="preserve">
    <value>Choisir la piste</value>
  </data>
  <data name="TourMixerChannelTrackBody" xml:space="preserve">
    <value>Ouvre la Bibliothèque pour choisir la piste que joue ce canal.</value>
  </data>
  <data name="TourMixerChannelSettingsTitle" xml:space="preserve">
    <value>Réglages du canal</value>
  </data>
  <data name="TourMixerChannelSettingsBody" xml:space="preserve">
