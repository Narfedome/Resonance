<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:components="clr-namespace:Resonance.Components"
             x:Class="Resonance.Components.DetailPageHeaderView"
             x:Name="root">
    <!-- En-tête maison pour les pages "d'accès" naviguées via le Shell (Route="...") plutôt que la
         barre native du Shell : sur Windows, cette dernière rendait la flèche retour coincée dans la
         barre de titre native (noire, non thématisée), au-dessus du titre stylé du Shell - deux barres
         empilées qui ne se ressemblent pas. La page hôte doit poser Shell.NavBarIsVisible="False".
         FaIconButtonView avec GhostIconButtonStyle (fond transparent) plutot que son accent plein
         par defaut : un bouton carré plein accent pour un simple retour est trop appuyé
         visuellement, comparé au chevron sombre et discret du Shell natif sur Android - mais on
         reutilise le composant (son vrai Button natif, avec zone de tap AppMinTouchTarget correcte
         d'office) plutot qu'un Label + VisualStateManager fait main. -->
    <!-- Margin gauche de 24 : même indentation que la barre native du Shell sur Android (dont on ne
         profite plus depuis qu'on masque Shell.NavBarIsVisible sur ces pages). -->
    <Grid ColumnDefinitions="auto,*" Margin="24,8,0,8">
        <components:FaIconButtonView Grid.Column="0"
                                      Style="{StaticResource GhostIconButtonStyle}"
                                      Icon="{x:Static icons:SolidFont.ChevronLeft}"
                                      IconSize="{OnIdiom Default=16, Desktop=14}"
                                      Command="{Binding Source={x:Reference root}, Path=BackCommand}"/>
        <Label Grid.Column="1" Text="{Binding Source={x:Reference root}, Path=Title}"
               FontSize="{OnIdiom Default=18, Desktop=15}" FontAttributes="Bold" Padding="8"
               VerticalOptions="Center" 
               TextColor="{DynamicResource AppTextPrimary}"/>
    </Grid>
</ContentView>
