<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resonance.Components.LibraryItemImageView"
             x:Name="root">

    <Image>
        <Image.Source>
            <Binding Path="ImagePath" Source="{x:Reference root}" TargetNullValue=""/>
        </Image.Source>
        <Image.Triggers>
            <!-- Si ImagePath est vide et que c'est un Track -->
            <MultiTrigger TargetType="Image">
                <MultiTrigger.Conditions>
                    <BindingCondition Binding="{Binding Source={x:Reference root}, Path=ImagePath}" Value=""/>
                </MultiTrigger.Conditions>
                <Setter Property="Source">
                    <Setter.Value>
                        <FontImageSource FontFamily="{Binding Source={x:Reference root}, Path=FontFamily}"
                                         Glyph="{Binding Source={x:Reference root}, Path=DefaultGlyph}"/>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Image.Triggers>
    </Image>
</ContentView>