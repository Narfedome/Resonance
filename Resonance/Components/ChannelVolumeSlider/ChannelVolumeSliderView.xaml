<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             x:Class="Resonance.Components.ChannelVolumeSliderView"
             x:Name="root"
             VerticalOptions="Fill">

    <!-- Retour au Slider natif MAUI (perf native, style natif gratuit via le Style global
         TargetType="Slider" - cf. Styles.xaml) plutôt qu'un GraphicsView dessiné à la main : ce
         dernier coûtait trop cher à l'initialisation sur Android dès qu'il y avait plusieurs
         channel strips. Le compromis : Rotation ne change pas le layout, donc InnerSlider a
         besoin qu'on lui donne sa longueur (avant rotation) explicitement - TrackHost.SizeChanged
         (code-behind) la lui fournit dynamiquement à partir de l'espace réellement alloué par la
         ligne "*" du Grid parent. -->
    <Grid RowDefinitions="Auto,*"
          WidthRequest="{Binding Source={x:Reference root}, Path=Thickness}">
        <!-- Valeur du volume, qui sert aussi d'interrupteur pour couper le son (ValueTappedCommand) :
             un bouton à part prenait une ligne entière, et le curseur devenait minuscule sur
             téléphone. Coupé, la valeur est remplacée par un haut-parleur barré. -->
        <Grid Grid.Row="0" HorizontalOptions="Center"
              ToolTipProperties.Text="{Binding Source={x:Reference root}, Path=ValueTooltip}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={x:Reference root}, Path=ValueTappedCommand}"/>
            </Grid.GestureRecognizers>
            <Label Text="{Binding Source={x:Reference root}, Path=ValueText}"
                   TextColor="{Binding Source={x:Reference root}, Path=TextColor}"
                   FontSize="{Binding Source={x:Reference root}, Path=FontSize}"
                   IsVisible="{Binding Source={x:Reference root}, Path=IsMuted, Converter={StaticResource InverseBoolConverter}}"
                   HorizontalOptions="Center" />
            <Label Text="{x:Static icons:SolidFont.VolumeXmark}" FontFamily="FontSolid"
                   TextColor="{DynamicResource AppDanger}"
                   FontSize="{Binding Source={x:Reference root}, Path=FontSize}"
                   IsVisible="{Binding Source={x:Reference root}, Path=IsMuted}"
                   HorizontalOptions="Center" />
        </Grid>

        <Grid x:Name="TrackHost" Grid.Row="1">
            <Slider x:Name="InnerSlider"
                    StyleId="ChannelVolumeSliderTrack"
                    Minimum="{Binding Source={x:Reference root}, Path=Minimum}"
                    Maximum="{Binding Source={x:Reference root}, Path=Maximum}"
                    Value="{Binding Source={x:Reference root}, Path=Value, Mode=TwoWay}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Rotation="{Binding Source={x:Reference root}, Path=RotationAngle}" />
        </Grid>
    </Grid>
</ContentView>
