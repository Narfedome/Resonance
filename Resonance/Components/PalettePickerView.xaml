<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resonance.Components.PalettePickerView">
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">

        <!-- A: Nuit & or -->
        <Border x:Name="BorderA" Grid.Column="0" HeightRequest="90" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SelectA"/>
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,26">
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <BoxView Grid.Column="0" Color="#1C1A2E"/>
                    <BoxView Grid.Column="1" Color="#F0EDF8"/>
                </Grid>
                <BoxView Grid.Row="0" HeightRequest="5" VerticalOptions="End" Color="#C9A84C"/>
                <Label Grid.Row="1" Text="Nuit &amp; or" FontSize="{OnIdiom Default=10, Desktop=9}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- B: Forêt profonde -->
        <Border x:Name="BorderB" Grid.Column="1" HeightRequest="90" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SelectB"/>
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,26">
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <BoxView Grid.Column="0" Color="#1A2318"/>
                    <BoxView Grid.Column="1" Color="#EDF4E8"/>
                </Grid>
                <BoxView Grid.Row="0" HeightRequest="5" VerticalOptions="End" Color="#7AAF5C"/>
                <Label Grid.Row="1" Text="Forêt profonde" FontSize="{OnIdiom Default=10, Desktop=9}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- C: Taverne & ambre -->
        <Border x:Name="BorderC" Grid.Column="2" HeightRequest="90" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SelectC"/>
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,26">
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <BoxView Grid.Column="0" Color="#1E1218"/>
                    <BoxView Grid.Column="1" Color="#FAF0E0"/>
                </Grid>
                <BoxView Grid.Row="0" HeightRequest="5" VerticalOptions="End" Color="#C47B3A"/>
                <Label Grid.Row="1" Text="Taverne &amp; ambre" FontSize="{OnIdiom Default=10, Desktop=9}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- D: Acier & brume -->
        <Border x:Name="BorderD" Grid.Column="3" HeightRequest="90" StrokeShape="RoundRectangle 10" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SelectD"/>
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,26">
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <BoxView Grid.Column="0" Color="#141C24"/>
                    <BoxView Grid.Column="1" Color="#EBF2F7"/>
                </Grid>
                <BoxView Grid.Row="0" HeightRequest="5" VerticalOptions="End" Color="#5B8FA8"/>
                <Label Grid.Row="1" Text="Acier &amp; brume" FontSize="{OnIdiom Default=10, Desktop=9}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</ContentView>
