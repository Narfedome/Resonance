<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Resonance.Components"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:local="clr-namespace:Resonance.Features.AudioMixer"
             xmlns:services="clr-namespace:Resonance.Services"
             xmlns:onboarding="clr-namespace:Plugin.Maui.Onboarding"
             x:Class="Resonance.Components.MixerGlobalControlsView"
             x:DataType="local:AudioMixerViewModel">

    <!-- Commandes générales sur UNE ligne compacte (tout lancer, tout couper en fondu, tout
         arrêter, volume général), affichée dans la carte de la scène (cf. MixerSceneSelectorView)
         pour laisser un maximum de hauteur aux canaux. Les boutons "ajouter" vivent au bas de
         chaque liste, et la scène libre a son bouton flottant (cf. AudioMixerPage). -->
    <Grid ColumnSpacing="6"
          ColumnDefinitions="auto,auto,auto,auto,*,auto"
          IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
        <Grid.Behaviors>
            <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.MixerGlobalKey}"/>
        </Grid.Behaviors>
        <components:FaIconButtonView Grid.Column="0" Style="{StaticResource PlainAccentIconButtonStyle}"
                                     Icon="{x:Static icons:SolidFont.Play}"
                                     Command="{Binding PlayAllCommand}"
                                     Tooltip="{loc:Loc MixerPlayAll}" />
        <components:FaIconButtonView Grid.Column="1" Style="{StaticResource PlainAccentIconButtonStyle}"
                                     Icon="{x:Static icons:SolidFont.VolumeXmark}"
                                     Command="{Binding FadeOutAllCommand}"
                                     Tooltip="{loc:Loc MixerFadeOutAll}" />
        <components:FaIconButtonView Grid.Column="2" Style="{StaticResource PlainAccentIconButtonStyle}"
                                     Icon="{x:Static icons:SolidFont.Stop}"
                                     Command="{Binding StopAllCommand}"
                                     Tooltip="{loc:Loc MixerStopAll}" />

        <!-- Volume général : multiplie le volume de chaque canal sans modifier leurs réglages. -->
        <Label Grid.Column="3" Text="{x:Static icons:SolidFont.VolumeHigh}" FontFamily="FontSolid"
               Margin="6,0,0,0" VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
        <Slider Grid.Column="4" Minimum="0" Maximum="1" VerticalOptions="Center"
                Value="{Binding MasterVolume}"
                ToolTipProperties.Text="{loc:Loc MixerMasterVolume}"
                SemanticProperties.Description="{loc:Loc MixerMasterVolumeName}" />
        <Label Grid.Column="5" Text="{Binding DisplayMasterVolume}" VerticalOptions="Center"
               HorizontalTextAlignment="End" MinimumWidthRequest="28"/>
    </Grid>
</ContentView>
