<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:dialogs="clr-namespace:Resonance.Components.Dialogs"
               x:TypeArguments="system:String"
               x:Class="Resonance.Components.Dialogs.PromptDialog"
               x:DataType="dialogs:PromptDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="{OnPlatform Default=Start, WinUI=Center}"
               Margin="{OnPlatform Default='0,80,0,0', WinUI='0'}">
    <!-- Même ancrage/raisons qu'CreateItemDialog (cf. ses commentaires) : ancré en haut sur
         Android/iOS pour rester stable quand le clavier s'ouvre, centré sur Windows (pas de clavier
         logiciel à éviter). -->
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                   TextColor="{DynamicResource AppText}"/>
            <Label Text="{Binding Message}"
                   IsVisible="{Binding HasMessage}"
                   TextColor="{DynamicResource AppTextMuted}"/>
            <Entry x:Name="InputEntry" Text="{Binding Text}" Placeholder="{Binding Placeholder}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding CancelLabel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
