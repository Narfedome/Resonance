<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:dialogs="clr-namespace:Resonance.Components.Dialogs"
               x:TypeArguments="system:Int32"
               x:Class="Resonance.Components.Dialogs.ActionSheetDialog"
               x:DataType="dialogs:ActionSheetDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                   TextColor="{DynamicResource AppText}"/>
            <ScrollView MaximumHeightRequest="320">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ActionSheetOption">
                            <Button Text="{Binding Label}"
                                    Style="{StaticResource DialogOptionButtonStyle}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type dialogs:ActionSheetDialogViewModel}}, Path=SelectCommand}"
                                    CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            <Button Text="{Binding CancelLabel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
