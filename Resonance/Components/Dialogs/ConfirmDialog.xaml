<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:dialogs="clr-namespace:Resonance.Components.Dialogs"
               x:TypeArguments="system:Boolean"
               x:Class="Resonance.Components.Dialogs.ConfirmDialog"
               x:DataType="dialogs:ConfirmDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                   TextColor="{DynamicResource AppText}"/>
            <Label Text="{Binding Message}"
                   TextColor="{DynamicResource AppTextMuted}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding CancelLabel}"
                        IsVisible="{Binding HasCancel}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Grid.ColumnSpan="{Binding ConfirmButtonColumnSpan}"
                        Text="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
