<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resonance.Components.ChannelStripView"
             xmlns:components ="clr-namespace:Resonance.Components"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"  WidthRequest="{DynamicResource AppChannelStripWidth}">
    <!-- Grid plutôt que VerticalStackLayout : un StackLayout ne redistribue jamais l'espace
         excédentaire à ses enfants (toujours dimensionné à la somme de leurs tailles naturelles),
         donc le slider ne pouvait pas s'étirer avec la fenêtre. Ici la ligne "*" absorbe tout
         l'espace vertical disponible/manquant pour le slider, avec MinimumHeightRequest comme
         plancher d'utilisabilité ; le nom de piste garde sa ligne "Auto", dimensionnée à son
         contenu réel (cf. RotatedLabelView). -->
    <Grid RowDefinitions="Auto,Auto,*,auto" RowSpacing="8">
        <components:FaIconButtonView Grid.Row="0"
                                     Icon="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseConverter}}"
                                     Command="{Binding TogglePlayCommand}"
                                     Tooltip="{Binding IsPlaying, Converter={StaticResource BoolToTooltipPlayPauseConverter}}"
                                     HorizontalOptions="Center" />
        <components:FaIconButtonView Grid.Row="1"
                                     Icon="{x:Static icons:SolidFont.Stop}"
                                     Command="{Binding StopPlaybackCommand}"
                                     Tooltip="{loc:Loc ChannelStop}"
                                     HorizontalOptions="Center" />

        <components:ChannelVolumeSliderView Grid.Row="2"
                                      Value="{Binding Volume, Mode=TwoWay}"
                                      ValueText="{Binding DisplayVolume}"
                                      Minimum="0" Maximum="1"
                                      MinimumHeightRequest="{DynamicResource AppChannelSliderMinHeight}"
                                      Thickness="{DynamicResource AppChannelStripWidth}" />

        <components:RotatedLabelView Grid.Row="3"
               Text="{Binding DisplayTrackName}"
               HorizontalOptions="Center"
               LineBreakMode="TailTruncation" />
    </Grid>
</ContentView>
