<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Resonance.Components"
             x:Class="Resonance.Components.ImportProgressPopupView"
             x:DataType="local:ImportProgressViewModel"
             BackgroundColor="Transparent">
    <Border Style="{StaticResource DialogCardBorderStyle}" WidthRequest="320">
        <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="True"
                                   Color="{DynamicResource AppAccent}"
                                   WidthRequest="18" HeightRequest="18"
                                   VerticalOptions="Center"/>
                <Label Text="{Binding Title}"
                       FontAttributes="Bold" FontSize="{DynamicResource AppFontSizeSectionTitle}"
                       TextColor="{DynamicResource AppText}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Text="{Binding CurrentFileName}"
                   TextColor="{DynamicResource AppTextMuted}"
                   Style="{StaticResource TruncatedLabelStyle}"/>
            <Label Text="{Binding ProgressText}"
                   TextColor="{DynamicResource AppTextMuted}"/>
            <Button Text="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding ShowCancelButton}"
                    IsEnabled="{Binding IsCancelling, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    HorizontalOptions="End"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
