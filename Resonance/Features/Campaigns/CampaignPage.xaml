<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Resonance.Features.Campaigns"
             xmlns:models="clr-namespace:Resonance.Models"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:components="clr-namespace:Resonance.Components"
             x:Class="Resonance.Features.Campaigns.CampaignPage"
             x:DataType="local:CampaignViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Le poids visuel diminue avec la profondeur plutôt que de répéter la même carte grise
                 3 fois : Campagne = carte pleine (bordure), Chapitre = simple trait du bas, Scène =
                 aucune bordure. Chacun a en plus sa propre icône (Campagne/Chapitre), pour rester
                 identifiable même sans comparer les tailles de police entre elles.
                 Ouvert/fermé (accent si IsExpanded, gris sinon) et sélection (barre LightSkyBlue à
                 gauche, cf. LibraryTrackView) restent pilotés par binding direct sur la ligne — jamais
                 par la sélection native du CollectionView (SelectionMode="None" : rendu natif trop
                 différent d'une plateforme à l'autre) ni par VisualStateManager (états Normal/Selected
                 pas fiables après les Insert/Remove de l'accordéon). -->
            <!-- RowBorderStyle (carte de ligne d'accordeon/liste : forme, padding, hauteur mini, gris
                 par defaut) vit desormais dans Styles.xaml - partagee avec CategoryListPage.xaml, qui
                 dupliquait ces memes 5 proprietes a la main. -->

            <!-- x:DataType sur le Style (pas seulement sur les DataTemplate) : sans lui, le binding
                 compile "IsExpanded"/"IsSelected" est resolu contre le x:DataType de la ContentPage
                 (CampaignViewModel), ou ni l'un ni l'autre n'existe - d'ou l'avertissement MAUIG2045 et
                 le repli sur un binding par reflexion, plus lent. IExpandableRow (CampaignRow/
                 SessionRow, pas SceneRow) suffit ici puisque ces deux styles ne servent jamais pour une
                 Scène. -->
            <Style x:Key="ExpandableRowBorderStyle" TargetType="Border" BasedOn="{StaticResource RowBorderStyle}" x:DataType="local:IExpandableRow">
                <Style.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChapterDividerStyle" TargetType="BoxView" x:DataType="local:IExpandableRow">
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="VerticalOptions" Value="End"/>
                <Setter Property="Color" Value="Grey"/>
                <Style.Triggers>
                    <DataTrigger TargetType="BoxView" Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Color" Value="{DynamicResource AppAccent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Couleur fixe (pas une DynamicResource liée au thème/palette) : comme dans la
                 Bibliothèque (LibraryTrackView, Stroke="LightSkyBlue" sur l'état Selected), pour que la
                 sélection ressorte quel que soit le thème choisi, et pour rester cohérent visuellement
                 avec l'indicateur de sélection déjà utilisé ailleurs dans l'appli.
                 x:DataType="local:ExplorerRow" (la base commune Campagne/Chapitre/Scène) : IsSelected y
                 est déclaré, cf. commentaire sur ExpandableRowBorderStyle ci-dessus pour la raison. -->
            <Style x:Key="SelectionMarkerStyle" TargetType="BoxView" x:DataType="local:ExplorerRow">
                <Setter Property="WidthRequest" Value="4"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="Color" Value="LightSkyBlue"/>
                <Setter Property="IsVisible" Value="{Binding IsSelected}"/>
            </Style>

            <!-- Poignée de glisser-déposer, partagée par les 3 gabarits ci-dessous : le Drag n'est
                 activable que depuis cette poignée (jamais toute la ligne) - cf. AudioMixerPage pour
                 le même choix et sa justification (drag souris Windows démarre dès le mouvement, sans
                 appui long ni délai configurable, contrairement au tactile). -->
            <Style x:Key="DragHandleBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppSurface}"/>
                <Setter Property="Stroke" Value="{DynamicResource AppBorder}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 6"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

            <!-- Encadré décoratif superposé (transparent au repos), affiché par-dessus la ligne
                 pendant le glisser-déposer (cf. CampaignPage.xaml.cs) : indépendant du Stroke natif du
                 Border racine de CampaignTemplate (déjà piloté par IsExpanded), pour ne jamais entrer
                 en conflit avec lui. InputTransparent : ne doit jamais intercepter les gestes destinés
                 au contenu en-dessous. RoundRectangle 8 : même rayon que RowBorderStyle (cohérence
                 visuelle avec le reste de l'accordéon). -->
            <Style x:Key="DragHighlightBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="Stroke" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
                <Setter Property="InputTransparent" Value="True"/>
            </Style>

            <!-- Le chevron reste une zone de tap à part avec un vrai toggle (ouvre ET ferme) : son
                 affordance visuelle appelle explicitement ce geste. Le reste de la ligne (titre, icône)
                 n'ouvre jamais que — jamais ne referme — pour ne pas surprendre l'utilisateur qui
                 retape la ligne juste pour la sélectionner (cf. OpenCampaign/OpenSession). -->
            <DataTemplate x:Key="CampaignTemplate" x:DataType="local:CampaignRow">
                <!-- Padding sur ce Grid englobant (pas Margin sur le Border racine) : le Margin de la
                     racine d'un DataTemplate de CollectionView n'est pas fiable sur Windows (cf.
                     commentaire sur SessionTemplate plus bas, même souci) - une valeur meme extreme
                     n'a alors aucun effet visuel.
                     IsFirstCampaign (tenu à jour par CampaignViewModel) retire ce padding pour la toute
                     première campagne de la liste : sinon l'espace ajouté pour séparer les campagnes
                     entre elles pousse aussi inutilement la première vers le bas. -->
                <Grid Padding="{DynamicResource AppCampaignRowMargin}">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsFirstCampaign}" Value="True">
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                    </Grid.Triggers>
                <Border Style="{StaticResource ExpandableRowBorderStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=OpenCampaignCommand}"
                            CommandParameter="{Binding .}"/>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnRowDrop" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="32,4,20,*,44" ColumnSpacing="10">
                        <!-- Poignée en tout premier, avant même le marqueur de sélection : accroche la
                             plus à gauche possible, comme sur une liste réordonnable classique.
                             GripVertical (colonne de points empilés) plutôt que Grip (grille 2D,
                             utilisée sur le Mixer) : ici la liste est verticale, l'icône doit suggérer
                             un glisser haut/bas. -->
                        <Border Grid.Column="0" Style="{StaticResource DragHandleBorderStyle}">
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer CanDrag="True" DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted"/>
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static icons:SolidFont.GripVertical}" FontFamily="FontSolid"
                                   FontSize="{OnIdiom Default=13, Desktop=11}" TextColor="{DynamicResource AppTextMuted}"/>
                        </Border>
                        <BoxView Grid.Column="1" Style="{StaticResource SelectionMarkerStyle}"/>
                        <Label Grid.Column="2" Text="{x:Static icons:SolidFont.Map}"
                               FontFamily="FontSolid" FontSize="{OnIdiom Default=15, Desktop=13}"
                               VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                        <Label Grid.Column="3" Text="{Binding Campaign.Title}" FontFamily="OpenSansSemibold" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                        <!-- FaIconButtonView (vrai Button) plutot que Label+TapGestureRecognizer : ButtonWidthRequest="44"
                             reprend la largeur de colonne d'origine (pas AppMinTouchTarget, qui varie par idiome et ne
                             correspondrait plus a "44" partout). ButtonHeightRequest="-1" (Unset) : par defaut le
                             bouton reste carre (cf. FaIconButtonView.xaml.cs), ici on le laisse plutot s'etirer
                             (VerticalOptions="Fill") jusqu'a la hauteur de la ligne, comme le faisait le Grid de tap
                             d'origine, au lieu de se reduire a un carre. -->
                        <components:FaIconButtonView Grid.Column="4" Style="{StaticResource GhostIconButtonStyle}"
                                                      ButtonWidthRequest="44" ButtonHeightRequest="-1" ButtonVerticalOptions="Fill"
                                                      Icon="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                      IconSize="{OnIdiom Default=16, Desktop=14}"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=ToggleCampaignCommand}"
                                                      CommandParameter="{Binding .}"/>
                        <Border x:Name="DragHighlightBorder" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource DragHighlightBorderStyle}"/>
                    </Grid>
                </Border>
                </Grid>
            </DataTemplate>

            <!-- Indentation par colonne dédiée plutôt que par Margin sur la racine du DataTemplate :
                 sur Windows, le Margin du root d'un DataTemplate de CollectionView n'est pas toujours
                 respecté (toutes les lignes ressortaient au même niveau) — une colonne vide est du
                 vrai contenu de layout, fiable sur toutes les plateformes. -->
            <DataTemplate x:Key="SessionTemplate" x:DataType="local:SessionRow">
                <!-- La poignée occupe la colonne 1, juste après l'indentation de profondeur (colonne
                     0) : accroche la plus à gauche possible du contenu réel de la ligne, cf.
                     CampaignTemplate pour le même choix et GripVertical. -->
                <Grid ColumnDefinitions="20,28,4,18,*,32" ColumnSpacing="8" Padding="{DynamicResource AppChapterRowPadding}" MinimumHeightRequest="48">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=OpenSessionCommand}"
                            CommandParameter="{Binding .}"/>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnRowDrop" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave"/>
                    </Grid.GestureRecognizers>
                    <BoxView Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource ChapterDividerStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource DragHandleBorderStyle}">
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer CanDrag="True" DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted"/>
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static icons:SolidFont.GripVertical}" FontFamily="FontSolid"
                               FontSize="{OnIdiom Default=12, Desktop=10}" TextColor="{DynamicResource AppTextMuted}"/>
                    </Border>
                    <BoxView Grid.Column="2" Style="{StaticResource SelectionMarkerStyle}"/>
                    <Label Grid.Column="3" Text="{x:Static icons:SolidFont.Bookmark}"
                           FontFamily="FontSolid" FontSize="{OnIdiom Default=13, Desktop=11}"
                           VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                    <Label Grid.Column="4" Text="{Binding Session.Title}" FontSize="{OnIdiom Default=15, Desktop=13}" FontAttributes="Italic" VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                    <!-- Même raison que le chevron Campagne ci-dessus (cf. CampaignTemplate) : ButtonWidthRequest="32"
                         reprend la largeur de colonne, ButtonHeightRequest="-1" laisse le bouton s'etirer sur toute
                         la ligne (VerticalOptions="Fill") au lieu du carre par defaut. -->
                    <components:FaIconButtonView Grid.Column="5" Style="{StaticResource GhostIconButtonStyle}"
                                                  ButtonWidthRequest="32" ButtonHeightRequest="-1" ButtonVerticalOptions="Fill"
                                                  Icon="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                  IconSize="{OnIdiom Default=15, Desktop=13}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=ToggleSessionCommand}"
                                                  CommandParameter="{Binding .}"/>
                    <Border x:Name="DragHighlightBorder" Grid.Column="0" Grid.ColumnSpan="6" Style="{StaticResource DragHighlightBorderStyle}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SceneTemplate" x:DataType="local:SceneRow">
                <!-- La poignée occupe la colonne 1, juste après l'indentation de profondeur (colonne
                     0) : accroche la plus à gauche possible du contenu réel de la ligne, cf.
                     CampaignTemplate pour le même choix et GripVertical. -->
                <Grid ColumnDefinitions="40,28,4,16,*,70" ColumnSpacing="8" Padding="{DynamicResource AppSceneRowPadding}" MinimumHeightRequest="48">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=SelectCommand}"
                            CommandParameter="{Binding .}"/>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnRowDrop" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave"/>
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="1" Style="{StaticResource DragHandleBorderStyle}">
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer CanDrag="True" DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted"/>
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static icons:SolidFont.GripVertical}" FontFamily="FontSolid"
                               FontSize="{OnIdiom Default=11, Desktop=9}" TextColor="{DynamicResource AppTextMuted}"/>
                    </Border>
                    <BoxView Grid.Column="2" Style="{StaticResource SelectionMarkerStyle}"/>
                    <Label Grid.Column="3" Text="{x:Static icons:SolidFont.MasksTheater}"
                           FontFamily="FontSolid" FontSize="{OnIdiom Default=12, Desktop=10}"
                           VerticalOptions="Center" TextColor="{DynamicResource AppTextMuted}"/>
                    <Label Grid.Column="4" Text="{Binding Scene.Title}" VerticalOptions="Center"
                           TextColor="{DynamicResource AppTextMuted}" Style="{StaticResource TruncatedLabelStyle}"/>
                    <Grid Grid.Column="5">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:CampaignViewModel}}, Path=LaunchCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="{loc:Loc BtnLaunch}"
                               FontSize="{OnIdiom Default=13, Desktop=11}" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource AppAccent}"/>
                    </Grid>
                    <Border x:Name="DragHighlightBorder" Grid.Column="0" Grid.ColumnSpan="6" Style="{StaticResource DragHighlightBorderStyle}"/>
                </Grid>
            </DataTemplate>

            <local:ExplorerRowTemplateSelector x:Key="RowTemplateSelector"
                                                CampaignTemplate="{StaticResource CampaignTemplate}"
                                                SessionTemplate="{StaticResource SessionTemplate}"
                                                SceneTemplate="{StaticResource SceneTemplate}"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <components:WatermarkedLayout>
    <Grid Padding="10" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding Loading.IsLoading}"
                           IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="80" HeightRequest="80"/>

        <!-- Gated sur IsInitialized (pas juste !Loading.IsLoading) : entre l'affichage de la page et
             le vrai début du chargement, Loading.IsLoading vaut encore false lui aussi, ce qui faisait
             apparaître brièvement le bouton "Créer" avant le spinner. -->
        <Grid Grid.Row="0" IsVisible="{Binding IsInitialized}">
            <!-- État vide : aucune campagne. Même gabarit et même largeur fixe que la Bibliothèque vide
                 (LibraryTrackView.xaml) : carte SectionCardBorderStyle (celle des blocs de Réglages)
                 pour regrouper visuellement le message plutôt que du texte flottant seul. -->
            <Border IsVisible="{Binding HasCampaigns, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{x:Static icons:SolidFont.Map}" FontFamily="FontSolid" FontSize="{OnIdiom Default=40, Desktop=34}"
                           TextColor="{DynamicResource AppTextMuted}" HorizontalOptions="Center"/>
                    <Label Text="{loc:Loc EmptyCampaignsTitle}" FontSize="{OnIdiom Default=18, Desktop=15}" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{loc:Loc EmptyCampaignsBody}" TextColor="{DynamicResource AppTextMuted}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Button Text="{loc:Loc DialogCreateItem}" Command="{Binding CreateCommand}" Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Rows}"
                            SelectionMode="None"
                            IsVisible="{Binding HasCampaigns}"
                            ItemTemplate="{StaticResource RowTemplateSelector}"/>
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,8">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc DialogCreateItem}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditCommand}"
                                         Tooltip="{loc:Loc BtnEditItem}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         IsEnabled="{Binding SelectedRow, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
