<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Resonance.Features.AudioMixer"
             xmlns:components="clr-namespace:Resonance.Components"
             xmlns:corevm="clr-namespace:Resonance.Components;assembly=Resonance.Core"
             xmlns:models="clr-namespace:Resonance.Models"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             x:Class="Resonance.Features.AudioMixer.AudioMixerPage"
             x:DataType="local:AudioMixerViewModel">

    <components:WatermarkedLayout>
    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:MixerSceneSelectorView Grid.Row="0" />

        <components:MixerGlobalControlsView Grid.Row="1" />

        <!-- Overlay de chargement de scène : couvre toute la page (fond semi-transparent) pendant
             la (re)création des channel strips. Le CollectionView étant un contrôle natif sur
             Windows, l'ordre visuel (ZIndex) ne suffit pas à bloquer ses interactions : chaque
             zone interactive est donc aussi désactivée via IsEnabled, en plus du blocage de la
             navigation Shell côté ViewModel. -->
        <Grid Grid.RowSpan="3"
              ZIndex="10"
              IsVisible="{Binding Loading.IsLoading}"
              BackgroundColor="{StaticResource AppOverlay}">
            <ActivityIndicator IsRunning="{Binding Loading.IsLoading}"
                               VerticalOptions="Center" HorizontalOptions="Center"
                               WidthRequest="120" HeightRequest="120"/>
        </Grid>

        <!-- Channels -->
        <Border Grid.Row="2"
                IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView x:Name="ChannelsCollectionView" ItemsSource="{Binding CurrentChannels}" ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="corevm:ChannelStripViewModel">
                        <!-- Drag restreint à la poignée (cf. plus bas), sur toutes les plateformes :
                             sur Windows le drag souris démarre dès le mouvement (pas d'appui long
                             ni de délai configurable), donc glisser depuis n'importe où sur la
                             carte déclenchait le drag par erreur en scrollant la liste horizontale.
                             Le Drop reste sur toute la carte (cible facile à viser). -->
                        <Grid>
                            <Grid.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True" Drop="OnChannelDrop" DragOver="OnChannelDragOver" DragLeave="OnChannelDragLeave"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Enveloppe visuelle de la carte : fond dont l'opacité suit le volume (0.15
                                 à 0.75, cf. VolumeToOpacityConverter - jamais 0 pour ne pas se confondre
                                 avec un canal désactivé/grisé), dans la même couleur que l'ancien contour
                                 "en lecture" (BoolToActiveStrokeConverter, donc transparent hors lecture) -
                                 repère d'ambiance sur le mix global d'un coup d'œil. Toujours appliqué à ce
                                 calque de fond dédié, jamais à la carte entière : les boutons/le texte
                                 restent lisibles quel que soit le volume. Ici, au niveau du DataTemplate
                                 plutôt que dans MixerChannelCardView, pour que ça couvre toute la carte
                                 (boutons compris) et reste au même niveau que DragHighlightBorder, qui
                                 joue un rôle décoratif similaire. -->
                                <Border Grid.Column="0" StrokeThickness="1" StrokeShape="Rectangle"
                                    Stroke="{DynamicResource AppBorder}">
                                <Grid>
                                    <!-- LiveVolume (pas Volume) : suit le volume RÉEL du player, qui
                                         rampe pendant un fade in/out (par piste, "Fade Out All", ou
                                         changement de scène - tous passent par FadeOut/FadeInAsync) au
                                         lieu de rester figé sur le réglage cible affiché par le slider.
                                         Rend le fade visible en direct sur ce fond, pas seulement audible. -->
                                        <Border StrokeThickness="0" InputTransparent="True" StrokeShape="Rectangle"
                                            Opacity="{Binding LiveVolume, Converter={StaticResource VolumeToOpacityConverter}}"
                                            Background="{Binding IsPlaying, Converter={StaticResource BoolToActiveStrokeConverter}}"/>

                                    <!-- Bandes de fade in (haut) / fade out (bas) : réglages persistés
                                         sur la piste de scène (IsFadeIn/IsFadeOut), affichées
                                         indépendamment de la lecture en cours - une information de
                                         configuration, pas un état "en train de se produire". Placées
                                         AVANT MixerChannelCardView (donc derrière) : à 1/4 de la hauteur
                                         de la carte, la zone déborde largement des boutons eux-mêmes
                                         (bouton play, poignée), donc reste visible tout autour même en
                                         dessous - contrairement à l'ancienne bande fixe de 26px, quasi
                                         entièrement recouverte. Derrière, les boutons restent nets plutôt
                                         que teintés par-dessus. -->
                                    <Grid InputTransparent="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                            <Border Grid.Row="0" StrokeThickness="0" StrokeShape="Rectangle"
                                                IsVisible="{Binding IsFadeOut}"
                                                Background="{Binding IsFadeOut, Converter={StaticResource FadeEdgeBrushConverter}}"/>
                                            <Border Grid.Row="2" StrokeThickness="0" StrokeShape="Rectangle"
                                                IsVisible="{Binding IsFadeIn}"
                                                Background="{Binding IsFadeIn, Converter={StaticResource FadeEdgeBrushConverter}, ConverterParameter=Bottom}"/>
                                    </Grid>

                                    <components:MixerChannelCardView />
                                </Grid>
                            </Border>
                            <!-- Encadré décoratif superposé, affiché pendant le glisser-déposer (cf.
                                 AudioMixerPage.xaml.cs) : indépendant du remplissage/des bandes
                                 ci-dessus, pour ne jamais entrer en conflit avec ces indicateurs.
                                 InputTransparent : n'intercepte jamais les gestes destinés au contenu
                                 en-dessous (Play/Stop, slider, boutons). -->
                            <Border x:Name="DragHighlightBorder" Grid.Column="0"
                                    BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8" InputTransparent="True"/>
                            <BoxView Grid.Column="1"
                                     Color="Gray"
                                     WidthRequest="1"
                                     VerticalOptions="Fill" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
