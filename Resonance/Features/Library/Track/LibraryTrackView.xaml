<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resonance.Features.Library.LibraryTrackView"
             xmlns:local="clr-namespace:Resonance.Features.Library"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:components="clr-namespace:Resonance.Components"
             xmlns:services="clr-namespace:Resonance.Services"
             xmlns:onboarding="clr-namespace:Plugin.Maui.Onboarding"
             x:Name="root"      >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Mode sélection (au moins une piste cochée, cf. LibraryTrackViewModel.LongPressItem) : une barre
             dédiée remplace l'en-tête - croix pour sortir, compteur, et "Tout sélectionner". -->
        <Grid Grid.Row="0" ColumnDefinitions="auto,*,auto" ColumnSpacing="8" Margin="8,0,8,8" MinimumHeightRequest="48"
              AutomationId="LibrarySelectionBar" IsVisible="{Binding HasSelection}">
            <components:FaIconButtonView Grid.Column="0" Style="{StaticResource GhostIconButtonStyle}"
                                         Icon="{x:Static icons:SolidFont.Xmark}"
                                         AutomationId="LibraryExitSelectionButton"
                                         Command="{Binding ExitSelectionCommand}"
                                         Tooltip="{loc:Loc LibCancel}"/>
            <Label Grid.Column="1" Text="{Binding SelectionCountText}" FontAttributes="Bold"
                   FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="{loc:Loc LibSelectAll}" Command="{Binding SelectAllCommand}"
                    AutomationId="LibrarySelectAllButton"
                    BackgroundColor="Transparent" TextColor="{DynamicResource AppAccent}"
                    FontSize="{OnIdiom Default=14, Desktop=12}" Padding="8,4" VerticalOptions="Center"/>
        </Grid>

        <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto" Grid.Row="0" Margin="8,0,8,8" ColumnSpacing="4" VerticalOptions="Center"
              IsVisible="{Binding HasSelection, Converter={StaticResource InverseBoolConverter}}">
            <!-- Recherche par titre, combinée au filtre de catégorie. Aussi dans le sélecteur de piste
                 du mixeur (IsCrud=False), où retrouver une piste parmi des centaines est le plus utile. -->
            <!-- Champ arrondi sur fond sombre (maquette d'harmonisation) : la SearchBar, sans son trait
                 natif (cf. Platforms/Android/AndroidHandlers), posée dans une pastille AppSurface. -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Padding="4,0"
                    StrokeThickness="0" StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource AppSurface}" MinimumHeightRequest="44">
                <SearchBar Text="{Binding SearchText}"
                           Placeholder="{loc:Loc LibSearchPlaceholder}"
                           SemanticProperties.Description="{loc:Loc LibSearchPlaceholder}"
                           VerticalOptions="Center"/>
            </Border>
            <Button Text="{Binding SelectedCategory}"
                    Command="{Binding SelectCategoryCommand}"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppAccent}"
                    FontSize="{OnIdiom Default=15, Desktop=13}"
                    HorizontalOptions="Start"
                    Padding="8,4">
                <Button.Behaviors>
                    <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryCategoryKey}"/>
                </Button.Behaviors>
            </Button>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Tags}"
                                         Command="{Binding ManageCategoriesCommand}"
                                         Tooltip="{loc:Loc LibManageCategories}"
                                         IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"
                                         Grid.Column="1">
                <components:FaIconButtonView.Behaviors>
                    <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryManageCategoriesKey}"/>
                </components:FaIconButtonView.Behaviors>
            </components:FaIconButtonView>
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <Grid Grid.Row="1" IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <!-- Bibliothèque vide (filtre "Tout") : carte centrée (style des blocs de Réglages) plutôt
                 que du texte flottant seul, avec des raccourcis directs vers les deux façons d'ajouter
                 une piste. IsVisible en sibling de la CollectionView (pas CollectionView.EmptyView, qui
                 étire son contenu sur toute la hauteur disponible sans respecter le centrage du Border -
                 constaté à l'usage). Boutons masqués en mode picker (IsCrud=False) : ajouter une piste
                 depuis une sélection en cours prêterait à confusion. -->
            <Border IsVisible="{Binding ShowEmptyLibraryCard}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{x:Static icons:SolidFont.Music}" FontFamily="FontSolid"
                           FontSize="{OnIdiom Default=40, Desktop=34}"
                           TextColor="{DynamicResource AppTextMuted}" HorizontalOptions="Center"/>
                    <Label Text="{loc:Loc EmptyTracksTitle}" FontSize="{OnIdiom Default=18, Desktop=15}" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{loc:Loc EmptyTracksBody}" TextColor="{DynamicResource AppTextMuted}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <!-- FlexLayout qui passe à la ligne (pas un HorizontalStackLayout) : sur téléphone,
                         "Importer plusieurs pistes" ne tenait pas à côté de l'autre bouton dans la carte de
                         340 et sortait coupé à droite. Côte à côte quand la place suffit, l'un sous l'autre
                         sinon. -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center" Margin="0,8,0,0"
                                IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
                        <Button Text="{loc:Loc LibImportOneTrackButton}" Command="{Binding CreateCommand}" Margin="5"/>
                        <Button Text="{loc:Loc LibImportMultipleTracksButton}" Command="{Binding ImportMultipleTracksCommand}" Margin="5"/>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Catégorie spécifique vide (le filtre ne matche juste rien) : même carte que l'état vide
                 ci-dessus, mais message seul, pas de raccourcis d'import (une piste importée n'atterrit
                 pas nécessairement dans cette catégorie). -->
            <Border IsVisible="{Binding ShowEmptyCategoryMessage}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{loc:Loc LibEmptyCategoryMessage}" TextColor="{DynamicResource AppTextMuted}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Recherche sans résultat : même carte, message dédié. -->
            <Border IsVisible="{Binding ShowNoSearchResults}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{loc:Loc LibSearchNoResults}" TextColor="{DynamicResource AppTextMuted}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Border>

        <!-- SelectionMode="None" (pas de sélection native) : sur Android, le fond de sélection natif
             du CollectionView reste teinté par colorAccent quel que soit le style posé dessus.
             SelectedTrackItem est donc géré à la main via un TapGestureRecognizer par tuile (cf.
             ItemTemplate) plutôt que par SelectedItem - même traitement que CategoryListPage. -->
        <CollectionView
                 IsVisible="{Binding HasTrackItems}"
                 x:Name="ItemsCollection"
                 Margin="11,0"
                 ItemsSource="{Binding TrackItems}"
                 IsGrouped="True"
                 SelectionMode="None"
                 ItemSizingStrategy="MeasureFirstItem"
                 Scrolled="OnCollectionViewScrolled"
                 ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.Behaviors>
                <components:ResponsiveGridSpanBehavior TileWidth="150"/>
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="12" HorizontalItemSpacing="10" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Margin="0,10"
                                   HeightRequest="30"/>
            </CollectionView.Footer>
            <!-- Toujours groupé en interne (cf. LibraryTrackViewModel.ShowGroupHeaders) : seul l'en-tête
                 est masqué hors du filtre "Tout", où il serait redondant avec le bouton de filtre déjà
                 affiché au-dessus de la liste. -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           IsVisible="{Binding Source={x:Reference root}, Path=BindingContext.ShowGroupHeaders}"
                           FontAttributes="Bold" TextTransform="Uppercase" CharacterSpacing="1.2"
                           FontSize="{OnIdiom Default=13, Desktop=12}"
                           TextColor="{DynamicResource AppTextMuted}"
                           Margin="4,12,4,8"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Tuile de la maquette d'harmonisation : pochette carrée aux coins arrondis, sans
                         cadre au repos, titre en dessous. Le contour doré n'apparaît que sur la piste
                         sélectionnée (tapée ou cochée). Tap et appui long passent par la pochette
                         (TrackButtonView.CoverTapCommand / CoverLongPressCommand) : tap = TapItem, appui
                         long = mode sélection (TileLongPressCommand, nul dans le sélecteur du mixeur). -->
                    <Grid RowDefinitions="auto,auto" RowSpacing="6" Padding="0,0,0,4" AutomationId="LibraryTrackTile">
                        <!-- Souris (Windows) : clic droit = appui long, maintenir le bouton n'étant pas un
                             geste naturel au bureau. -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Buttons="Secondary"
                                                  Command="{Binding Source={x:Reference root}, Path=TileLongPressCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryTrackTileKey}"/>
                        </Grid.Behaviors>
                        <Border StrokeShape="RoundRectangle 14" StrokeThickness="2" Stroke="Transparent" Padding="2"
                                HeightRequest="{Binding Source={x:Reference root}, Path=TileSize}"
                                WidthRequest="{Binding Source={x:Reference root}, Path=TileSize}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPrimarySelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                </DataTrigger>
                                <!-- En mode sélection, seul ce qui est coché est doré : la piste courante perd
                                     son contour (déclencheurs appliqués dans l'ordre, le dernier l'emporte). -->
                                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference root}, Path=BindingContext.HasSelection}" Value="True">
                                    <Setter Property="Stroke" Value="Transparent"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid>
                                <components:TrackButtonView CurrentTrack="{Binding .}"
                                                            SelectCommand="{Binding Source={x:Reference root}, Path=BindingContext.SelectItemCommand}"
                                                            ShowPlayButton="{Binding Source={x:Reference root}, Path=BindingContext.HasSelection, Converter={StaticResource InverseBoolConverter}}"
                                                            CoverTapCommand="{Binding Source={x:Reference root}, Path=BindingContext.TapItemCommand}"
                                                            CoverLongPressCommand="{Binding Source={x:Reference root}, Path=TileLongPressCommand}"/>
                                <!-- Case à cocher de la sélection multiple : n'apparaît qu'en mode sélection
                                     (entré par appui long sur une tuile), plus en permanence. -->
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsVisible="{Binding Source={x:Reference root}, Path=BindingContext.HasSelection}"
                                          Color="{DynamicResource AppAccent}"
                                          HorizontalOptions="Start" VerticalOptions="Start"/>
                            </Grid>
                        </Border>
                        <Label Grid.Row="1" Text="{Binding Title}" AutomationId="LibraryTrackTitle"
                               FontSize="{OnIdiom Default=13, Desktop=12}" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" Style="{StaticResource TruncatedLabelStyle}"
                               WidthRequest="{Binding Source={x:Reference root}, Path=TileSize}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference root}, Path=BindingContext.TapItemCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD, masqués pendant le chargement de la liste) :
             un seul bloc centré, séparé en 2 sous-groupes (Ajouter-Éditer-Supprimer comme dans Campagnes /
             import ; "Tout sélectionner" vit désormais dans la barre du mode sélection) par un fin trait plutôt que d'étaler les boutons isolés sur toute
             la largeur - ça reste un seul groupe cohérent même sur une fenêtre large. -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <!-- Indice discret tant qu'on n'est pas en mode sélection : l'appui long n'a aucune autre
                 affordance visible. -->
            <Label Text="{OnIdiom Default={loc:Loc LibLongPressHint}, Desktop={loc:Loc LibRightClickHint}}" FontSize="{OnIdiom Default=12, Desktop=11}"
                   TextColor="{DynamicResource AppTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   Margin="24,4,24,0" IsVisible="{Binding HasTrackItems}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasSelection}" Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="8,8"
                                   IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                             Command="{Binding CreateCommand}"
                                             Tooltip="{loc:Loc LibAdd}">
                    <components:FaIconButtonView.Behaviors>
                        <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryAddKey}"/>
                    </components:FaIconButtonView.Behaviors>
                </components:FaIconButtonView>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.FolderPlus}"
                                             Command="{Binding ImportMultipleTracksCommand}"
                                             Tooltip="{loc:Loc LibImport}">
                    <components:FaIconButtonView.Behaviors>
                        <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryImportKey}"/>
                    </components:FaIconButtonView.Behaviors>
                </components:FaIconButtonView>
                <BoxView WidthRequest="1" HeightRequest="28" VerticalOptions="Center" Margin="4,0" Color="{DynamicResource AppBorder}"/>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                             Command="{Binding EditCommand}"
                                             Tooltip="{loc:Loc LibEdit}"
                                             IsEnabled="{Binding SelectedTrackItem, Converter={StaticResource IsNotNullConverter}}">
                    <components:FaIconButtonView.Behaviors>
                        <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryEditKey}"/>
                    </components:FaIconButtonView.Behaviors>
                </components:FaIconButtonView>
                <components:FaIconButtonView Style="{StaticResource DangerIconButtonStyle}" Icon="{x:Static icons:SolidFont.Trash}"
                                             AutomationId="LibraryDeleteButton"
                                             Command="{Binding DeleteSelectedItemsCommand}"
                                             Tooltip="{Binding DeleteTooltip}"
                                             IsEnabled="{Binding CanDelete}">
                    <components:FaIconButtonView.Behaviors>
                        <onboarding:OnboardingTargetBehavior Key="{x:Static services:AppTourService.LibraryDeleteKey}"/>
                    </components:FaIconButtonView.Behaviors>
                </components:FaIconButtonView>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="8,8"
                                   IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleCheck}"
                                               Command="{Binding ConfirmSelectionCommand}"
                                               Tooltip="{loc:Loc LibConfirm}"/>
                <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleXmark}"
                                               Command="{Binding CancelCommand}"
                                               Tooltip="{loc:Loc LibCancel}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
