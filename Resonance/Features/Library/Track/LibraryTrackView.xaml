<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resonance.Features.Library.LibraryTrackView"
             xmlns:local="clr-namespace:Resonance.Features.Library"
             xmlns:icons="clr-namespace:Resonance.Resources.Icons"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:components="clr-namespace:Resonance.Components"
             x:Name="root"      >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnDefinitions="*,auto" Grid.Row="0" Margin="8,0,8,8" ColumnSpacing="4" VerticalOptions="Center">
            <Button Text="{Binding SelectedCategory}"
                    Command="{Binding SelectCategoryCommand}"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppAccent}"
                    FontSize="{OnIdiom Default=15, Desktop=13}"
                    HorizontalOptions="Start"
                    Padding="8,4"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Tags}"
                                         Command="{Binding ManageCategoriesCommand}"
                                         Tooltip="{loc:Loc LibManageCategories}"
                                         IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"
                                         Grid.Column="1"/>
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <Grid Grid.Row="1" IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <!-- Bibliothèque vide (filtre "Tout") : carte centrée (style des blocs de Réglages) plutôt
                 que du texte flottant seul, avec des raccourcis directs vers les deux façons d'ajouter
                 une piste. IsVisible en sibling de la CollectionView (pas CollectionView.EmptyView, qui
                 étire son contenu sur toute la hauteur disponible sans respecter le centrage du Border -
                 constaté à l'usage). Boutons masqués en mode picker (IsCrud=False) : ajouter une piste
                 depuis une sélection en cours prêterait à confusion. -->
            <Border IsVisible="{Binding ShowEmptyLibraryCard}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{x:Static icons:SolidFont.Music}" FontFamily="FontSolid"
                           FontSize="{OnIdiom Default=40, Desktop=34}"
                           TextColor="{DynamicResource AppTextMuted}" HorizontalOptions="Center"/>
                    <Label Text="{loc:Loc EmptyTracksTitle}" FontSize="{OnIdiom Default=18, Desktop=15}" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{loc:Loc EmptyTracksBody}" TextColor="{DynamicResource AppTextMuted}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,8,0,0"
                                           IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
                        <Button Text="{loc:Loc LibImportOneTrackButton}" Command="{Binding CreateCommand}"/>
                        <Button Text="{loc:Loc LibImportMultipleTracksButton}" Command="{Binding ImportMultipleTracksCommand}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Catégorie spécifique vide (le filtre ne matche juste rien) : même carte que l'état vide
                 ci-dessus, mais message seul, pas de raccourcis d'import (une piste importée n'atterrit
                 pas nécessairement dans cette catégorie). -->
            <Border IsVisible="{Binding ShowEmptyCategoryMessage}"
                    Style="{StaticResource SectionCardBorderStyle}" WidthRequest="340"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{loc:Loc LibEmptyCategoryMessage}" TextColor="{DynamicResource AppTextMuted}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Border>

        <!-- SelectionMode="None" (pas de sélection native) : sur Android, le fond de sélection natif
             du CollectionView reste teinté par colorAccent quel que soit le style posé dessus.
             SelectedTrackItem est donc géré à la main via un TapGestureRecognizer par tuile (cf.
             ItemTemplate) plutôt que par SelectedItem - même traitement que CategoryListPage. -->
        <CollectionView
                 IsVisible="{Binding HasTrackItems}"
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding TrackItems}"
                 IsGrouped="True"
                 SelectionMode="None"
                 ItemSizingStrategy="MeasureFirstItem"
                 Scrolled="OnCollectionViewScrolled"
                 ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.Behaviors>
                <components:ResponsiveGridSpanBehavior TileWidth="150"/>
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Margin="0,10"
                                   HeightRequest="30"/>
            </CollectionView.Footer>
            <!-- Toujours groupé en interne (cf. LibraryTrackViewModel.ShowGroupHeaders) : seul l'en-tête
                 est masqué hors du filtre "Tout", où il serait redondant avec le bouton de filtre déjà
                 affiché au-dessus de la liste. -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           IsVisible="{Binding Source={x:Reference root}, Path=BindingContext.ShowGroupHeaders}"
                           FontAttributes="Bold"
                           FontSize="{DynamicResource AppFontSizeSectionTitle}"
                           TextColor="{DynamicResource AppText}"
                           Margin="4,12,4,4"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- BackgroundColor="Transparent" écrase le fond translucide du style partagé
                         (toujours utile à LibrarySpellView, resté en sélection native) : ici, plus
                         besoin de masquer quoi que ce soit puisque la sélection native (et donc son
                         fond orange) n'est plus utilisée du tout. -->
                    <Border Style="{StaticResource SelectableGridItemBorderStyle}" BackgroundColor="Transparent" Stroke="Grey">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectItemCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <!-- VisualStateManager.VisualStateGroups vidé ici : le state "Normal" du style
                             partagé réaffirme Stroke=Grey en continu et passe devant le DataTrigger
                             ci-dessous (VSM prioritaire sur les Trigger en MAUI), ce qui empêchait tout
                             affichage du liseré bleu. Le gris de base vient donc du Stroke="Grey" posé
                             juste au-dessus, en dur sur cette instance. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList/>
                        </VisualStateManager.VisualStateGroups>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPrimarySelected}" Value="True">
                                <Setter Property="Stroke" Value="LightSkyBlue"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid WidthRequest="120" HeightRequest="120"  Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:TrackButtonView    CurrentTrack="{Binding .}"
                                                           SelectCommand="{Binding Source={x:Reference root}, Path=BindingContext.SelectItemCommand}" />
                            <!-- Case à cocher pour la sélection multiple (visible uniquement en mode CRUD) -->
                            <CheckBox Grid.Row="0"
                                      IsChecked="{Binding IsSelected}"
                                      IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"
                                      HorizontalOptions="Start" VerticalOptions="Start"/>
                            <!-- Label au lieu de l'image -->
                            <Label Text="{Binding Title}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"
                        Grid.Row="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD, masqués pendant le chargement de la liste) :
             un seul bloc centré, séparé en 3 sous-groupes (sélection / Ajouter-Éditer-Supprimer comme
             dans Campagnes / import) par un fin trait plutôt que d'étaler les boutons isolés sur toute
             la largeur - ça reste un seul groupe cohérent même sur une fenêtre large. -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="8,8"
                                   IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CheckDouble}"
                                             Command="{Binding SelectAllCommand}"
                                             Tooltip="{loc:Loc LibSelectAll}"
                                             IsEnabled="{Binding HasTrackItems}"/>
                <BoxView WidthRequest="1" HeightRequest="28" VerticalOptions="Center" Margin="4,0" Color="{DynamicResource AppTextMuted}"/>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                             Command="{Binding CreateCommand}"
                                             Tooltip="{loc:Loc LibAdd}"/>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                             Command="{Binding EditCommand}"
                                             Tooltip="{loc:Loc LibEdit}"
                                             IsEnabled="{Binding SelectedTrackItem, Converter={StaticResource IsNotNullConverter}}"/>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                             Command="{Binding DeleteSelectedItemsCommand}"
                                             Tooltip="{Binding DeleteTooltip}"
                                             IsEnabled="{Binding CanDelete}"/>
                <BoxView WidthRequest="1" HeightRequest="28" VerticalOptions="Center" Margin="4,0" Color="{DynamicResource AppTextMuted}"/>
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.FolderPlus}"
                                             Command="{Binding ImportMultipleTracksCommand}"
                                             Tooltip="{loc:Loc LibImport}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="8,8"
                                   IsVisible="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleCheck}"
                                               Command="{Binding ConfirmSelectionCommand}"
                                               Tooltip="{loc:Loc LibConfirm}"/>
                <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleXmark}"
                                               Command="{Binding CancelCommand}"
                                               Tooltip="{loc:Loc LibCancel}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
