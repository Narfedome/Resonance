<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Resonance.Features.Settings"
             xmlns:loc="clr-namespace:Resonance.Extensions"
             xmlns:components="clr-namespace:Resonance.Components"
             x:Class="Resonance.Features.Settings.SettingsPage"
             x:DataType="local:SettingsViewModel">

    <!-- Réglages regroupés en blocs titrés (Apparence, Données, Découvrir, À propos) plutôt qu'une
         carte par réglage : une carte par bloc, des lignes séparées par un trait fin, la valeur ou
         l'action en doré à droite. La version descend en pied de page. -->
    <ContentPage.Resources>
        <Style x:Key="SettingsGroupTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnIdiom Default=12, Desktop=11}"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="1.2"/>
            <Setter Property="TextTransform" Value="Uppercase"/>
            <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}"/>
            <Setter Property="Margin" Value="4,8,0,-8"/>
        </Style>
        <Style x:Key="SettingsGroupCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardBorderStyle}">
            <Setter Property="Padding" Value="16,4"/>
        </Style>
        <Style x:Key="SettingsRowStyle" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="*,auto"/>
            <Setter Property="ColumnSpacing" Value="12"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="MinimumHeightRequest" Value="{OnIdiom Default=52, Desktop=44}"/>
        </Style>
        <Style x:Key="SettingsRowSubtitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnIdiom Default=12, Desktop=11}"/>
            <Setter Property="TextColor" Value="{DynamicResource AppTextMuted}"/>
        </Style>
        <Style x:Key="SettingsRowActionStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{DynamicResource AppAccent}"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="{OnIdiom Default=15, Desktop=13}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="MinimumHeightRequest" Value="{DynamicResource AppInlineButtonMinSize}"/>
            <Setter Property="MinimumWidthRequest" Value="{DynamicResource AppInlineButtonMinSize}"/>
        </Style>
        <Style x:Key="SettingsRowDividerStyle" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1"/>
            <Setter Property="Color" Value="{DynamicResource AppBorder}"/>
        </Style>
    </ContentPage.Resources>

    <components:WatermarkedLayout>
    <ScrollView>
        <!-- Sur Desktop, une fenêtre large étirait chaque carte de section bord à bord - plafonnée et
             centrée à la place (comme les pages de préférences Windows/macOS), plutôt qu'une grille
             (contenu trop hétérogène en hauteur, casserait l'ordre de lecture haut en bas). Fait en
             code-behind (cf. SettingsPage.xaml.cs), pas via OnPlatform ici : contrairement à
             WidthRequest, -1 n'est PAS la valeur "pas de contrainte" pour MaximumWidthRequest (dont le
             vrai défaut est PositiveInfinity) - la mettre explicitement à -1 pour Android écrasait tout
             le contenu à une largeur nulle, page blanche. Plus sûr de ne pas toucher à cette propriété
             du tout sur Android/iOS. -->
        <VerticalStackLayout x:Name="ContentStack" Padding="16,12,16,20" Spacing="16">

            <!-- ===== Apparence ===== -->
            <Label Text="{loc:Loc SettingsGroupAppearance}" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsLanguage}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{Binding SelectedLanguageLabel}" Command="{Binding SelectLanguageCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsTheme}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{Binding SelectedThemeOption}" Command="{Binding SelectThemeCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <VerticalStackLayout Spacing="12" Padding="0,14,0,12">
                        <Label Text="{loc:Loc SettingsPalette}"/>
                        <components:PalettePickerView SelectedPalette="{Binding SelectedPalette, Mode=TwoWay}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Données ===== -->
            <Label Text="{loc:Loc SettingsGroupData}" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{loc:Loc SettingsStorageTitle}"/>
                            <Label Text="{Binding StorageUsedText}" Style="{StaticResource SettingsRowSubtitleStyle}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsStorageCleanupButton}" Command="{Binding CleanupStorageCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{loc:Loc ImportExportTitle}"/>
                            <Label Text="{loc:Loc ImportExportSettingsDesc}" Style="{StaticResource SettingsRowSubtitleStyle}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc ImportExportOpenButton}" Command="{Binding OpenImportExportCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsStorageDeleteAllTracksDesc}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                TextColor="{DynamicResource AppDanger}"
                                Text="{loc:Loc SettingsStorageDeleteAllButton}" Command="{Binding DeleteAllTracksCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Découvrir : campagne d'exemple et accueil, retrouvables après le premier lancement ===== -->
            <Label Text="{loc:Loc SettingsGroupDiscover}" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsSampleDesc}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                AutomationId="SettingsSampleButton"
                                Text="{loc:Loc SettingsSampleButton}" Command="{Binding LoadSampleCampaignCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsTourDesc}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsTourButton}" Command="{Binding StartTourCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsWelcomeDesc}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsWelcomeButton}" Command="{Binding ReplayWelcomeCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== À propos : soutien, signalement de bug et journal d'erreurs ===== -->
            <Label Text="{loc:Loc SettingsGroupAbout}" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsSupportTitle}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsSupportDesc}" Command="{Binding OpenCoffeeLinkCommand}"/>
                    </Grid>
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Label Text="{loc:Loc SettingsReportBugTitle}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsReportBugDesc}" Command="{Binding ReportBugCommand}"/>
                    </Grid>
                    <!-- Journal d'erreurs (crash.log) : affiché seulement s'il contient quelque chose, pour
                         pouvoir le joindre au signalement (le formulaire ne prend pas de fichier). -->
                    <BoxView Style="{StaticResource SettingsRowDividerStyle}" IsVisible="{Binding HasCrashLog}"/>
                    <Grid Style="{StaticResource SettingsRowStyle}" IsVisible="{Binding HasCrashLog}">
                        <Label Text="{loc:Loc SettingsCrashLogDesc}" VerticalOptions="Center"/>
                        <!-- Partage système sur mobile ; sous Windows, l'Explorateur sur le fichier (cf.
                             SettingsViewModel.ShowCrashLog : le partage n'y fonctionne pas). -->
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsCrashLogShare}" Command="{Binding ShareCrashLogCommand}"
                                IsVisible="{OnPlatform Default=True, WinUI=False}"/>
                        <Button Grid.Column="1" Style="{StaticResource SettingsRowActionStyle}"
                                Text="{loc:Loc SettingsCrashLogShow}" Command="{Binding ShowCrashLogCommand}"
                                IsVisible="{OnPlatform Default=False, WinUI=True}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Version en pied de page, discrète. -->
            <Label HorizontalOptions="Center" Margin="0,4,0,0"
                   FontSize="{OnIdiom Default=12, Desktop=11}" TextColor="{DynamicResource AppTextMuted}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Resonance "/>
                        <Span Text="{Binding AppVersion}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
    </components:WatermarkedLayout>
</ContentPage>