# Config locale pour Build-Release.ps1 - propre a chaque machine, jamais commitee.
#
# 1. Recuperer "dmtools-release.keystore" depuis le Drive partage et le deposer dans ce meme
#    dossier Deploy\ (a cote de Build-Release.ps1). Le nom de fichier est fixe, rien a configurer
#    pour le chemin.
# 2. Copier ce fichier en "Build-Release.local.ps1" (a cote de Build-Release.ps1, toujours dans
#    Deploy\) et renseigner les identifiants ci-dessous.
#    (Astuce : garder aussi une copie du vrai Build-Release.local.ps1 rempli dans le meme dossier
#    Drive que la keystore, pour recuperer les deux fichiers d'un coup sur un nouveau PC.)
# 3. C'est tout : Build-Release.ps1 charge ce fichier automatiquement s'il existe.
#
# Keystore generee une seule fois avec keytool, puis copiee sur le Drive partage :
#   keytool -genkeypair -v -keystore dmtools-release.keystore -alias dmtools -keyalg RSA -keysize 2048 -validity 10000

$env:DMTOOLS_KEYSTORE_ALIAS     = "dmtools"
$env:DMTOOLS_KEYSTORE_STOREPASS = "mot-de-passe-keystore"
$env:DMTOOLS_KEYSTORE_KEYPASS   = "mot-de-passe-cle"

# Optionnel : Build Hook Netlify (Site settings > Build & deploy > Build hooks sur netlify.com).
# Avec ca, Build-Release.ps1 redeploie le site automatiquement juste apres avoir publie la
# GitHub Release - sans, le site attend le prochain push sur master pour se mettre a jour.
$env:DMTOOLS_NETLIFY_BUILD_HOOK = "https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxxxxxxxxxx"

# Optionnel : soumission automatique du MSIX au Microsoft Store (necessite le Microsoft Store
# Developer CLI : winget install "Microsoft Store Developer CLI"). Sans PRODUCT_ID, le MSIX reste
# sous Deploy\MicrosoftStore\ pour un upload manuel.
# - PRODUCT_ID : Partner Center > l'appli > Gestion des produits > Identite du produit (Store ID, 9N...).
# - SELLER_ID  : Partner Center > Parametres du compte > Informations legales > Developpeur (Seller ID).
# - TENANT_ID / CLIENT_ID / CLIENT_SECRET : Partner Center > Parametres du compte > Gestion des
#   utilisateurs > Applications Microsoft Entra : creer une appli avec le role Manager, puis
#   "Ajouter une cle" pour obtenir le secret.
$env:DMTOOLS_MSSTORE_PRODUCT_ID    = "9NXXXXXXXXXX"
$env:DMTOOLS_MSSTORE_SELLER_ID     = "00000000"
$env:DMTOOLS_MSSTORE_TENANT_ID     = "00000000-0000-0000-0000-000000000000"
$env:DMTOOLS_MSSTORE_CLIENT_ID     = "00000000-0000-0000-0000-000000000000"
$env:DMTOOLS_MSSTORE_CLIENT_SECRET = "secret-de-l-appli-entra"

# Publication automatique de l'AAB sur Google Play (Deploy\PlayPublisher.cs) : deposer dans ce
# dossier Deploy\ la cle JSON du compte de service (recuperee depuis le Drive partage, gitignoree
# comme la keystore) suffit, rien a configurer. Sans cle, l'AAB reste sous Deploy\PlayStore\ pour
# un upload manuel dans la Play Console. Les notes de version reprennent la section de la version
# majeure.mineure du changelog du site (Website\changelog.html et en\changelog.html).
# Cle : compte de service Google Cloud (projet avec l'API "Google Play Android Developer API"
# activee), invite dans Play Console > Utilisateurs et autorisations avec "Afficher les informations
# sur l'application" et "Mettre les applications a disposition de tous les utilisateurs". La meme
# cle sert pour toutes les applis du compte Play.
# Optionnel :
# - SERVICE_ACCOUNT_JSON : chemin d'une cle rangee ailleurs que dans Deploy\.
# - TRACK : piste cible (production par defaut, sinon beta, alpha, internal).
# $env:DMTOOLS_PLAY_SERVICE_ACCOUNT_JSON = "C:\chemin\vers\narfedome-xxxxxxxxxxxx.json"
# $env:DMTOOLS_PLAY_TRACK                = "production"
