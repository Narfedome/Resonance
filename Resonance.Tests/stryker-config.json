{
  "stryker-config": {
    "project": "Resonance.Core.csproj",
    "mutate": [
      "**/Services/LibraryDataService.cs",
      "**/Services/SceneDataService.cs",
      "**/Services/ImportExportService.cs",
      "**/Services/TrackTagHelper.cs",
      "**/Services/TextSearch.cs",
